    "@expo-google-fonts/space-grotesk": "0.4.1",
    "@expo/metro-runtime": "57.0.9",
    "@sentry/react-native": "~7.11.0",
    "@shellty/api-contracts": "workspace:*",
    "@shellty/i18n": "workspace:*",
    "@shellty/ui": "workspace:*",
    "@tanstack/react-query": "^5.101.2",
    "expo": "57.0.12",
    "expo-asset": "57.0.10",
    "expo-audio": "~57.0.3",
    "expo-constants": "57.0.10",
    "expo-file-system": "~57.0.2",
    "expo-font": "57.0.1",
    "expo-linking": "57.0.5",
    "expo-localization": "57.0.1",
    "expo-router": "57.0.12",
    "expo-secure-store": "^57.0.1",
    "expo-speech": "^57.0.1",
    "expo-splash-screen": "57.0.6",
    "expo-status-bar": "57.0.1",
    "expo-updates": "~57.0.13",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "0.21.2"
